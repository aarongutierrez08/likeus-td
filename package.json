    "simtest": "tsx tools/simtest.ts",
    "balance": "tsx tools/balance.ts",
    "shot": "tsx tools/shot.ts",
    "dump": "tsx tools/dump.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
