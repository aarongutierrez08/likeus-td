{
  "name": "td",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "pnpm --parallel --filter @td/client --filter @td/server run dev",
    "check": "pnpm -r run check",
