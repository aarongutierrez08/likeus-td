{
  "permissions": {
    "allow": [
      "Bash(pnpm *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Read(**)",
      "Edit(packages/**)",
      "Edit(tools/**)",
      "Edit(docs/adr/**)",
      "Edit(.claude/**)",
      "Edit(CLAUDE.md)"
    ],
    "deny": [
      "Edit(.claude/settings.json)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      { "matcher": "Edit|Write|MultiEdit",
        "hooks": [ { "type": "command", "command": "bash .claude/hooks/typecheck.sh" } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "bash .claude/hooks/notify-done.sh" } ] }
    ],
    "Notification": [
      { "hooks": [ { "type": "command", "command": "bash .claude/hooks/notify-wait.sh" } ] }
    ]
  }
}
